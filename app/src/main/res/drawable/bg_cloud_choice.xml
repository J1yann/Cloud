<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <corners android:radius="14dp" />
            <solid android:color="?attr/cloudAccentSoft" />
            <stroke android:width="1dp" android:color="?attr/cloudAccentColor" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="14dp" />
            <solid android:color="?attr/cloudSurfaceColor" />
            <stroke android:width="1dp" android:color="?attr/cloudDividerColor" />
        </shape>
    </item>
</selector>
