<?xml version="1.0" encoding="utf-8"?>
<com.hjq.shape.view.ShapeEditText xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/etSearch"
    android:layout_width="match_parent"
    android:layout_height="32dp"
    android:layout_gravity="center_vertical"
    android:drawablePadding="6dp"
    android:gravity="center_vertical"
    android:hint="Search tracks, artists, and playlists"
    android:imeOptions="actionSearch"
    android:paddingHorizontal="10dp"
    android:paddingVertical="0dp"
    android:singleLine="true"
    android:textColor="?attr/cloudTextPrimary"
    android:textColorHint="?attr/cloudTextSecondary"
    android:textSize="14dp"
    app:drawableStartCompat="@drawable/ic_menu_search"
    app:drawableTint="?attr/cloudTextSecondary"
    app:shape_radius="100dp"
    app:shape_solidColor="?attr/cloudSurfaceColor"
    app:shape_strokeColor="?attr/cloudDividerColor"
    app:shape_strokeSize="1dp" />