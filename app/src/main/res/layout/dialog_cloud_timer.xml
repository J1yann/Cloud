<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <ImageView android:layout_width="48dp" android:layout_height="48dp"
            android:padding="12dp" android:background="@drawable/bg_cloud_choice"
            android:src="@drawable/ic_menu_timer" android:importantForAccessibility="no"
            app:tint="@color/cloud_accent" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="@string/cloud_timer_title"
            android:textSize="24sp" android:fontFamily="sans-serif-medium"
            android:textColor="@color/common_text_h1_color" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/cloud_timer_description"
            android:textSize="14sp" android:textColor="@color/common_text_h2_color" />
        <LinearLayout android:id="@+id/timerOptions" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="24dp"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
